# Required for chat, multilingual AI advisories, transcription, and leaf analysis.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Use a Groq vision-capable model available to your account.
GROQ_VISION_MODEL=

# Required for live weather. Never commit a real key.
OPENWEATHER_API_KEY=

# Required for live AGMARKNET market data.
DATAGOV_API_KEY=
DATAGOV_MARKET_RESOURCE_ID=9ef84268-d588-465a-a308-a864a43d0070

# Optional deployment configuration.
FRONTEND_URL=http://localhost:5173
VITE_BACKEND_URL=http://127.0.0.1:8000
REDIS_URL=redis://localhost:6379
