# Required for chat synthesis and optional vision features
GROQ_API_KEY=your_groq_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Required for leaf disease image analysis
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_VISION_MODEL=gemini-2.5-flash

# Optional data providers
DATAGOV_API_KEY=your_datagov_key_here
DATAGOV_MARKET_RESOURCE_ID=9ef84268-d588-465a-a308-a864a43d0070
OPENWEATHER_API_KEY=your_openweather_key_here

# Optional retrieval settings
USE_CROSS_ENCODER=false
MAX_RETRIEVAL_CANDIDATES=25
MAX_CONTEXT_CHUNKS=6
MIN_LOCAL_RETRIEVAL_SCORE=0.34
MIN_DOC_RELEVANCE=0.45

# Optional application services
REDIS_URL=redis://localhost:6379
FRONTEND_URL=http://localhost:5173
CHECKPOINT_DB_PATH=./runtime/checkpoints.db

# Local email/password accounts and signed browser sessions
AUTH_DATABASE_PATH=./runtime/auth.sqlite3
# OAuth 2.0 Web client ID from Google Cloud Console (also configure in frontend/.env)
GOOGLE_CLIENT_ID=
# Set to true when serving the app over HTTPS
AUTH_COOKIE_SECURE=false